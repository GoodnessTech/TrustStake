# TrustStake Environment Configuration

# Deployer / Operator Private Key (Do not commit real private keys)
PRIVATE_KEY=your_private_key_here_without_0x

# BOT Chain Testnet (Bohr) - Active Development Target
BOT_TESTNET_CHAIN_ID=968
BOT_TESTNET_RPC_URL=https://rpc.bohr.life
BOT_TESTNET_EXPLORER=https://scan.bohr.life

# BOT Chain Mainnet - Prepared, Guarded
BOT_MAINNET_CHAIN_ID=677
BOT_MAINNET_RPC_URL=https://rpc.botchain.ai
BOT_MAINNET_EXPLORER=https://scan.botchain.ai

# Active Environment Selection ('testnet' or 'mainnet')
TRUSTSTAKE_ENV=testnet

# Mainnet Deployment Protective Guard (Strictly 'false' by default)
ALLOW_MAINNET_DEPLOY=false

# Indexer and API Port
PORT=4001
